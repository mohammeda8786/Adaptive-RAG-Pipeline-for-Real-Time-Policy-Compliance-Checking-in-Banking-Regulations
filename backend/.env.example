QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=rbi_regulations
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
# Set to 1 for HTTPS; leave 0 for local HTTP development.
JWT_COOKIE_SECURE=1
JWT_COOKIE_SAMESITE=none
RBI_CORS_ORIGINS=https://your-app.vercel.app
# Optional Google OAuth credentials; keep the client secret on the backend only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-backend.onrender.com/api/auth/google/callback
RBI_FRONTEND_URL=https://your-app.vercel.app
CORS_ORIGINS=https://your-app.vercel.app
RBI_DATA_DIR=/app/data
RBI_DATABASE_PATH=/app/data/rbi_chat.sqlite3
RBI_REPORT_DIR=/app/data/reports
RBI_POLICY_DIR=/app/data/bank_policies
RBI_TEXT_DIR=/app/data/rbi_text
RBI_QUERY_AUDIT_LOG=/app/data/query_analyzer_audit.jsonl
RBI_QUERY_ANALYZER_FALLBACK=single_original_query
RBI_DISABLE_LLM=0

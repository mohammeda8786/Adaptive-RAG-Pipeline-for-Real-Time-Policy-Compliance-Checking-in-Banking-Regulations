QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=rbi_regulations
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
# Set to 1 for HTTPS; leave 0 for local HTTP development.
JWT_COOKIE_SECURE=0
RBI_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Optional Google OAuth credentials; keep the client secret on the backend only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback
RBI_FRONTEND_URL=http://127.0.0.1:5173
RBI_QUERY_ANALYZER_FALLBACK=single_original_query
RBI_DISABLE_LLM=0
